# Use um projeto Supabase cuja autenticação esteja configurada para este teste.
# Nunca coloque senha, service_role, sb_secret ou token administrativo aqui.
FINACE_SUPABASE_URL=https://seu-projeto.supabase.co
FINACE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_sua_chave_publica
# Só habilitar após conferir SMTP, ambos os modelos de e-mail e confirmação obrigatória.
FINACE_EMAIL_OTP_READY=false
